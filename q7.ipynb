   "source": [
    "# Calculating the frquency of the letter 'a' in the given string\n",
    "\n",
    "count = 0\n",
    "str1 = \"Hi, I am John. I am learning Python programming language. Python is a great language for data science and machine learning.\"\n",
    "for ch in str1:\n",
    "    if ch == 'a':\n",
    "        count += 1\n",
    "print(count)"
   ]
